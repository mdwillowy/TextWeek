NODE_ENV=production
PORT=5050
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_URI=
CLIENT_ORIGIN=
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
SOCKET_CORS_ORIGIN=https://your-frontend-domain.com
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
REQUEST_BODY_LIMIT=100kb
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_MESSAGE_WINDOW_MS=60000
RATE_LIMIT_MESSAGE_MAX=45
RATE_LIMIT_SEARCH_WINDOW_MS=60000
RATE_LIMIT_SEARCH_MAX=40
RATE_LIMIT_FOLLOW_WINDOW_MS=60000
RATE_LIMIT_FOLLOW_MAX=40
RATE_LIMIT_REPORT_WINDOW_MS=600000
RATE_LIMIT_REPORT_MAX=20
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=30
RETENTION_DAYS=7
RETENTION_INTERVAL_HOURS=24
RETENTION_RUN_ON_STARTUP=true
INTERNAL_JOB_TOKEN=replace_with_internal_job_token
TRUST_PROXY=true
LOG_LEVEL=info
SENTRY_DSN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ENABLE_NEW_REGISTRATIONS=true
FEATURE_READ_RECEIPTS=true
FEATURE_ONLINE_STATUS=true
FEATURE_E2EE=true
